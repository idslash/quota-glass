<Window
    x:Class="LimitBar.Glass.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lg="using:LiquidGlassWinUI">
    <Grid Background="Transparent">
        <Border CornerRadius="26" Padding="18" BorderBrush="#70D9EDFF" BorderThickness="1">
            <Border.Background>
                <lg:LiquidGlassBrush BlurAmount="2.2" BloomAmount="0.22" Brightness="0.055"
                    Contrast="1.09" Exposure="1.08" Saturation="1.12" Vibrance="0.16"
                    RefThickness="56" RefFactor="2.65" RefDispersion="3.4"
                    RefFresnelRange="52" RefFresnelFactor="24" GlareAngle="-38"
                    GlareFactor="42" GlareOppositeFactor="24" ShapeRadius="0.82"
                    ShapeRoundness="4.2" TintA="0.10" TintR="20" TintG="35" TintB="56" />
            </Border.Background>
            <Grid RowDefinitions="Auto,1,*,Auto">
                <Grid x:Name="DragRegion" Grid.Row="0" Margin="2,0,0,14" ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Spacing="1">
                        <TextBlock Text="LIMITBAR" FontSize="10" CharacterSpacing="115" FontWeight="SemiBold" Foreground="#FF9BCAFF" />
                        <TextBlock Text="Plan usage" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Claude + ChatGPT" FontSize="12" Foreground="#B8D5E5F4" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="RefreshButton" Click="RefreshButton_Click" Width="34" Height="34" Margin="0,3,6,0" Padding="0" CornerRadius="17" Background="#241D3045" BorderBrush="#55D8ECFF" Content="↻" FontSize="15" />
                    <Button Grid.Column="2" x:Name="HideButton" Click="HideButton_Click" Width="34" Height="34" Margin="0,3,0,0" Padding="0" CornerRadius="17" Background="#241D3045" BorderBrush="#55D8ECFF" Content="×" FontSize="14" />
                </Grid>
                <Rectangle Grid.Row="1" Height="1" Fill="#44D8ECFF" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,10">
                    <StackPanel x:Name="UsageCards" Spacing="10" />
                </ScrollViewer>
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="UpdatedText" Text="Waiting for data" FontSize="11" Foreground="#A7BCC9D8" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="#FF62E8B1" />
                        <TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold" Foreground="#FF72EAB8" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
